{
  "name": "tiangz-examples",
  "version": "0.6.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "packages": "node tools/example_package.mjs list",
    "setup": "node tools/example_package.mjs setup",
    "build": "node tools/example_package.mjs build",
    "start": "node tools/example_package.mjs start",
    "smoke": "node tools/example_package.mjs smoke",
    "dev": "node tools/example_package.mjs dev",
    "client:open": "node tools/example_package.mjs client-open",
    "client:build": "node tools/example_package.mjs client-build",
    "test:packages": "node --test tools/example_package.test.mjs",
    "server:prepare": "node tools/server.mjs prepare",
    "server:check": "node tools/server.mjs check",
    "server:build": "node tools/server.mjs build",
    "server:native-build": "node tools/server.mjs native-build",
    "server:start": "node tools/server.mjs start",
    "codegen:sdk": "node tools/codegen_sdk.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sdk:sync": "node tools/clients.mjs sdk:sync",
    "sdk:check": "node tools/clients.mjs sdk:check",
    "check": "node tools/example_package.mjs check",
    "check:clients": "node tools/clients.mjs check",
    "typecheck:cocos-demo": "node tools/typecheck_cocos_demo.mjs",
    "typecheck:cocos3d-demo": "node tools/typecheck_cocos3d_demo.mjs",
    "check:godot-demo": "node tools/check_godot_demo.mjs",
    "build:pixi": "node tools/clients.mjs build:pixi",
    "serve:pixi": "node tools/serve_pixi.mjs",
    "build:cocos2d:web": "node tools/build_cocos.mjs --project 2d --target web",
    "build:cocos3d:web": "node tools/build_cocos.mjs --project 3d --target web",
    "build:cocos3d:external": "node tools/build_cocos_external.mjs",
    "typecheck:cocos-net": "tsc -p clients/cocos_client2D_3.8.6/tsconfig.protocol.json",
    "typecheck:cocos-demo:engine": "tsc -p clients/cocos_client2D_3.8.6/tsconfig.json --noEmit",
    "typecheck:cocos3d-demo:engine": "tsc -p clients/cocos_client3D_3.8.8/tsconfig.json --noEmit",
    "typecheck:pixi": "tsc -p clients/pixi_client_8.19.0/tsconfig.json",
    "check:cocos-demo": "esbuild clients/cocos_client2D_3.8.6/assets/scripts/Demo/GameBootstrap.ts --bundle --platform=browser --format=esm --target=es2022 --tsconfig=clients/cocos_client2D_3.8.6/tsconfig.bundle.json --external:cc --external:cc/env --outfile=dist/cocos_demo_check.js",
    "check:cocos3d-demo": "esbuild clients/cocos_client3D_3.8.8/assets/scripts/Demo/GameBootstrap3D.ts --bundle --platform=browser --format=esm --target=es2022 --tsconfig=clients/cocos_client2D_3.8.6/tsconfig.bundle.json --external:cc --external:cc/env --outfile=dist/cocos3d_demo_check.js",
    "build:cocos2d:web:debug": "node tools/build_cocos.mjs --project 2d --target web --mode debug",
    "build:cocos2d:mobile": "node tools/build_cocos.mjs --project 2d --target mobile",
    "build:cocos2d:mobile:debug": "node tools/build_cocos.mjs --project 2d --target mobile --mode debug",
    "build:cocos3d:web:debug": "node tools/build_cocos.mjs --project 3d --target web --mode debug",
    "build:cocos3d:mobile": "node tools/build_cocos.mjs --project 3d --target mobile",
    "build:cocos3d:mobile:debug": "node tools/build_cocos.mjs --project 3d --target mobile --mode debug",
    "check:cocos-build": "node tools/build_cocos.mjs --project 3d --target web --dry-run",
    "smoke:pixi": "node tools/pixi_browser_smoke.mjs",
    "test:movement-prediction": "esbuild tools/movement_prediction_self_test.ts --bundle --platform=node --tsconfig=clients/cocos_client2D_3.8.6/tsconfig.bundle.json --format=cjs --outfile=dist/movement_prediction.cjs && node dist/movement_prediction.cjs",
    "asset:cocos3d:blue-chibi": "node tools/assets/generate_blue_chibi.mjs",
    "test:protocol": "vitest run tests/legacy/protocol_self_test.test.ts",
    "test:actor": "vitest run tests/legacy/actor_self_test.test.ts",
    "test:client-sdk": "vitest run tests/legacy/client_sdk_runtime_self_test.test.ts",
    "test:map-broadcast": "vitest run tests/legacy/map_broadcast_self_test.test.ts",
    "test:map-aoi": "vitest run tests/legacy/map_aoi_visibility_self_test.test.ts",
    "test:player-persistence": "vitest run tests/legacy/player_persistence_self_test.test.ts",
    "test:monster-behavior": "vitest run tests/legacy/monster_behavior_self_test.test.ts",
    "test:summon": "vitest run tests/legacy/summon_self_test.test.ts",
    "test:player-revive": "vitest run tests/legacy/player_revive_self_test.test.ts",
    "test:progression": "vitest run tests/legacy/progression_self_test.test.ts",
    "test:loot-ownership": "vitest run tests/legacy/loot_ownership_self_test.test.ts",
    "test:combat": "vitest run tests/legacy/combat_self_test.test.ts",
    "test:buff-action": "vitest run tests/legacy/buff_action_self_test.test.ts",
    "test:npc-shop": "vitest run tests/legacy/npc_shop_self_test.test.ts",
    "test:npc-repair": "vitest run tests/legacy/npc_repair_self_test.test.ts",
    "test:npc-combat": "vitest run tests/legacy/npc_combat_self_test.test.ts",
    "test:trainer": "vitest run tests/legacy/trainer_self_test.test.ts",
    "test:interactable": "vitest run tests/legacy/interactable_self_test.test.ts",
    "test:runtime-content-patch": "vitest run tests/legacy/runtime_content_patch_self_test.test.ts",
    "test:spawn-selection": "vitest run tests/legacy/spawn_selection_self_test.test.ts",
    "test:player-trade": "vitest run tests/legacy/player_trade_self_test.test.ts",
    "test:loot-roll": "vitest run tests/legacy/loot_roll_self_test.test.ts",
    "test:gate-reconnect": "vitest run tests/legacy/gate_reconnect_self_test.test.ts",
    "test:location": "vitest run tests/legacy/location_self_test.test.ts",
    "test:runtime": "node tools/runtime_smoke.mjs",
    "verify:server-assets": "node tools/observability/verify_observability.mjs && node tools/verify_production_deploy.mjs && node --test tools/chaos/recovery_acceptance.test.mjs",
    "test:native": "node tools/native_test.mjs",
    "test:perf-runtime-log": "node tools/runtime_log_health_self_test.mjs",
    "verify": "npm run server:build && npm test && npm run codegen:sdk && npm run sdk:sync && npm run check:clients && npm run verify:server-assets && npm run test:packages",
    "hello": "npm run server:build && npm run server:native-build && npm run server:start"
  },
  "devDependencies": {
    "vitest": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "@tiangz/dbproxy-sdk": "file:../TiangZ-DBProxy",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.0",
    "pixi.js": "^8.9.2",
    "typescript": "^6.0.0"
  }
}
